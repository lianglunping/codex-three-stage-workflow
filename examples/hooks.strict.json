{
  "description": "Optional strict guard for a dedicated, explicitly activated three-stage session; do not merge globally.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/three_stage_write_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking optional strict three-stage boundary"
          }
        ]
      }
    ]
  }
}
